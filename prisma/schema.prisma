generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Team {
  id         String   @id @default(uuid())
  name       String
  // Shared with people who should join the team; regenerated by an admin.
  inviteCode String   @unique @map("invite_code")
  createdAt  DateTime @default(now()) @map("created_at")

  users     User[]
  materials Material[]
  clients   Client[]
  projects  Project[]
  formulas  Formula[]

  @@map("teams")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  // "admin" manages members and the invite code; "member" works on the data.
  role         String   @default("member")
  teamId       String   @map("team_id")
  createdAt    DateTime @default(now()) @map("created_at")

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("users")
}

model Material {
  id              String  @id @default(uuid())
  casNumber       String? @map("cas_number")
  name            String
  family          String?
  sensation       String? @db.Text
  weight          Float?
  subjectivePower Float?  @map("subjective_power")
  descriptors     Json
  source          String  @default("catalog")
  origin          String  @default("natural")
  regulatory      Json?

  // Lab inventory data (Rangement frigo MP). `nature` is the chemical nature
  // of the raw material, distinct from `origin` (catalog vs formula-derived).
  nature             String?
  ifraCat4           String? @map("ifra_cat4") @db.Text
  cosmeticRegulation String? @map("cosmetic_regulation") @db.Text
  allergens          String? @db.Text
  flavor             String? @db.Text
  flavorRestriction  String? @map("flavor_restriction") @db.Text

  // Technical sheet, filled in by hand from the material page.
  adjacentNote         String?  @map("adjacent_note") @db.Text
  regulation           String?  @db.Text
  freeNote             String?  @map("free_note") @db.Text
  visualAspect         String?  @map("visual_aspect")
  flashPoint           String?  @map("flash_point")
  physicochemicalState String?  @map("physicochemical_state")
  waterBase            Boolean? @map("water_base")

  sourceFormulaId String?  @unique @map("source_formula_id")
  sourceFormula   Formula? @relation("FormulaAsMaterial", fields: [sourceFormulaId], references: [id], onDelete: SetNull)

  formulaLines FormulaLine[]
  stocks       MaterialStock[]

  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, name])
  @@map("materials")
}

model MaterialStock {
  id         Int     @id @default(autoincrement())
  materialId String  @map("material_id")
  label      String
  supplier   String?
  producer   String?
  location   String?
  stockGrams Float?  @map("stock_grams")
  stockNote  String? @map("stock_note")
  source     String  @default("rangement")

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@map("material_stocks")
}

model Formula {
  id            String   @id @default(uuid())
  name          String
  facets        Json?
  adjustments   Json?
  totalVolumeMl Float?   @map("total_volume_ml")
  source        String   @default("user")
  status        String   @default("draft")
  createdAt     DateTime @default(now()) @map("created_at")

  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  lines           FormulaLine[]
  materializedAs  Material?     @relation("FormulaAsMaterial")

  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])

  @@map("formulas")
}

model Client {
  id                String   @id @default(uuid())
  company           String?
  contactFirstName  String?  @map("contact_first_name")
  contactLastName   String?  @map("contact_last_name")
  contactEmail      String?  @map("contact_email")
  contactPhone      String?  @map("contact_phone")
  createdAt         DateTime @default(now()) @map("created_at")

  projects Project[]

  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("clients")
}

model Project {
  id          String    @id @default(uuid())
  name        String
  clientId    String    @map("client_id")
  description String?   @db.Text
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime  @default(now()) @map("created_at")

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  formulas Formula[]

  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])

  @@unique([clientId, name])
  @@map("projects")
}

model FormulaLine {
  id         Int    @id @default(autoincrement())
  formulaId  String @map("formula_id")
  materialId String @map("material_id")
  quantity   Float

  formula  Formula  @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@map("formula_lines")
}
