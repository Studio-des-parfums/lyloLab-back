generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Material {
  id              String  @id @default(uuid())
  casNumber       String? @map("cas_number")
  name            String  @unique
  family          String?
  sensation       String? @db.Text
  weight          Float?
  subjectivePower Float?  @map("subjective_power")
  descriptors     Json
  source          String  @default("catalog")
  regulatory      Json?

  formulaLines FormulaLine[]

  @@map("materials")
}

model Formula {
  id          String   @id @default(uuid())
  name        String
  facets      Json?
  adjustments Json?
  source      String   @default("user")
  createdAt   DateTime @default(now()) @map("created_at")

  lines FormulaLine[]

  @@map("formulas")
}

model FormulaLine {
  id         Int    @id @default(autoincrement())
  formulaId  String @map("formula_id")
  materialId String @map("material_id")
  quantity   Float

  formula  Formula  @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@map("formula_lines")
}
