generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Team {
  id         String   @id @default(uuid())
  name       String
  // Shared with people who should join the team; regenerated by an admin.
  inviteCode String   @unique @map("invite_code")
  createdAt  DateTime @default(now()) @map("created_at")

  users     User[]
  materials Material[]
  clients   Client[]
  projects  Project[]
  formulas  Formula[]
  regulations Regulation[]

  @@map("teams")
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  name         String
  passwordHash String   @map("password_hash")
  // "admin" manages members and the invite code; "member" works on the data.
  role         String   @default("member")
  teamId       String   @map("team_id")
  createdAt    DateTime @default(now()) @map("created_at")

  team     Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  formulas Formula[]

  @@index([teamId])
  @@map("users")
}

model Material {
  id              String  @id @default(uuid())
  casNumber       String? @map("cas_number")
  name            String
  family          String?
  sensation       String? @db.Text
  weight          Float?
  subjectivePower Float?  @map("subjective_power")
  descriptors     Json
  source          String  @default("catalog")
  origin          String  @default("natural")
  regulatory      Json?

  // Lab inventory data (Rangement frigo MP). `nature` is the chemical nature
  // of the raw material, distinct from `origin` (catalog vs formula-derived).
  nature             String?
  ifraCat4           String? @map("ifra_cat4") @db.Text
  cosmeticRegulation String? @map("cosmetic_regulation") @db.Text
  allergens          String? @db.Text
  flavor             String? @db.Text
  flavorRestriction  String? @map("flavor_restriction") @db.Text

  // Technical sheet, filled in by hand from the material page.
  adjacentNote         String?  @map("adjacent_note") @db.Text
  regulation           String?  @db.Text
  freeNote             String?  @map("free_note") @db.Text
  visualAspect         String?  @map("visual_aspect")
  flashPoint           String?  @map("flash_point")
  physicochemicalState String?  @map("physicochemical_state")
  waterBase            Boolean? @map("water_base")

  sourceFormulaId String?  @unique @map("source_formula_id")
  sourceFormula   Formula? @relation("FormulaAsMaterial", fields: [sourceFormulaId], references: [id], onDelete: SetNull)

  formulaLines FormulaLine[]
  stocks       MaterialStock[]
  regulationEntries RegulationEntry[]

  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, name])
  @@map("materials")
}

model MaterialStock {
  id         Int     @id @default(autoincrement())
  materialId String  @map("material_id")
  label      String
  supplier   String?
  producer   String?
  location   String?
  stockGrams Float?  @map("stock_grams")
  stockNote  String? @map("stock_note")
  source     String  @default("rangement")

  material Material @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@index([materialId])
  @@map("material_stocks")
}

model Formula {
  id            String   @id @default(uuid())
  name          String
  facets        Json?
  adjustments   Json?
  totalVolumeMl Float?   @map("total_volume_ml")
  source        String   @default("user")
  status        String   @default("draft")
  createdAt     DateTime @default(now()) @map("created_at")

  projectId String?  @map("project_id")
  project   Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  lines           FormulaLine[]
  materializedAs  Material?     @relation("FormulaAsMaterial")

  createdById   String? @map("created_by_id")
  createdBy     User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)
  // Kept so the author still shows once their account is removed from the team.
  createdByName String? @map("created_by_name")

  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])

  @@map("formulas")
}

model Client {
  id                String   @id @default(uuid())
  company           String?
  contactFirstName  String?  @map("contact_first_name")
  contactLastName   String?  @map("contact_last_name")
  contactEmail      String?  @map("contact_email")
  contactPhone      String?  @map("contact_phone")
  createdAt         DateTime @default(now()) @map("created_at")

  projects Project[]

  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("clients")
}

model Project {
  id          String    @id @default(uuid())
  name        String
  clientId    String    @map("client_id")
  description String?   @db.Text
  startDate   DateTime? @map("start_date")
  endDate     DateTime? @map("end_date")
  createdAt   DateTime  @default(now()) @map("created_at")

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  formulas Formula[]

  teamId String @map("team_id")
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])

  @@unique([clientId, name])
  @@map("projects")
}

model FormulaLine {
  id         Int    @id @default(autoincrement())
  formulaId  String @map("formula_id")
  materialId String @map("material_id")
  quantity   Float

  formula  Formula  @relation(fields: [formulaId], references: [id], onDelete: Cascade)
  material Material @relation(fields: [materialId], references: [id])

  @@map("formula_lines")
}

// A regulation: either an official one (shared by every team, teamId null,
// identified by `code`) or a custom one created by a team (client
// specification, internal policy…).
model Regulation {
  id            String    @id @default(uuid())
  // Stable key of an official regulation, used by the sync rules (null for custom ones).
  code          String?   @unique
  name          String
  description   String?   @db.Text
  // Where the rule applies, used to filter the regulations page.
  continent     String?
  country       String?
  // Date from which the regulation applies, when it is not in force yet.
  effectiveFrom DateTime? @map("effective_from")
  // "in_force", "upcoming" (adopted, not applicable yet) or "proposal".
  status        String    @default("in_force")
  // How its substance list applies to materials: "declare" (label above a
  // threshold) or "ban". Null when the regulation has a dedicated rule.
  substanceRule String?   @map("substance_rule")
  createdAt     DateTime  @default(now()) @map("created_at")

  entries     RegulationEntry[]
  substances  RegulatedSubstance[]
  sources     RegulationSource[]

  teamId String? @map("team_id")
  team   Team?   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@index([teamId])
  @@map("regulations")
}

// Link table between materials and regulations: one row per material
// concerned by a regulation, with its status for that regulation.
model RegulationEntry {
  id         String   @id @default(uuid())
  // Short status ("Max 0.6 %", "Interdite", "Limonene, Linalool"…).
  status     String
  // Maximum % in the formula: 0 = banned, null = no numeric limit.
  maxPercent Float?   @map("max_percent")
  detail     String?  @db.Text
  note       String?  @db.Text
  // "sync" rows are recomputed from the material's regulatory data;
  // "manual" rows are entered by hand on custom regulations.
  origin     String   @default("manual")
  updatedAt  DateTime @updatedAt @map("updated_at")

  regulationId String     @map("regulation_id")
  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  materialId   String     @map("material_id")
  material     Material   @relation(fields: [materialId], references: [id], onDelete: Cascade)

  @@unique([regulationId, materialId])
  @@index([materialId])
  @@map("regulation_entries")
}

// Substances listed by a regulation (e.g. the 26 EU fragrance allergens).
model RegulatedSubstance {
  id        String  @id @default(uuid())
  // Canonical name, as used in materials' regulatory.allergens.
  name      String
  casNumber String? @map("cas_number")
  // Other spellings matched as the same substance.
  aliases   Json?
  note      String? @db.Text

  regulationId String     @map("regulation_id")
  regulation   Regulation @relation(fields: [regulationId], references: [id], onDelete: Cascade)

  @@unique([regulationId, name])
  @@map("regulated_substances")
}

// Official texts and references (from the "References tableau" sheet).
model OfficialSource {
  id           String  @id @default(uuid())
  ref          Int     @unique
  jurisdiction String
  organisation String
  title        String  @db.Text
  date         String
  url          String  @db.Text
  usage        String? @db.Text

  regulations RegulationSource[]

  @@map("official_sources")
}

model RegulationSource {
  regulationId String         @map("regulation_id")
  regulation   Regulation     @relation(fields: [regulationId], references: [id], onDelete: Cascade)
  sourceId     String         @map("source_id")
  source       OfficialSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([regulationId, sourceId])
  @@map("regulation_sources")
}
