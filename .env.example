PORT=3000
DATABASE_URL="mysql://user:password@host:port/database"

# Assistant IA (OpenAI)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_REASONING_EFFORT=low
OPENAI_WEB_SEARCH=true
# Saisie vocale de l'assistant
OPENAI_TRANSCRIBE_MODEL=gpt-4o-transcribe

# Signature des sessions : chaîne aléatoire de 32 caractères minimum (ex. openssl rand -base64 48)
JWT_SECRET=
